{
  "name": "zyra-assistant",
  "version": "1.0.0",
  "description": "Zyra Assistant - A Node.js + TypeScript personal AI assistant",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:client": "npm --prefix client run dev",
    "build": "tsc",
    "build:client": "npm --prefix client run build",
    "start": "node dist/index.js",
    "test": "tsx tests/verify.ts",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@andresaya/edge-tts": "^1.8.1",
    "@anthropic-ai/sdk": "^0.32.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^8.0.0",
    "node-cron": "^3.0.3",
    "ollama": "^0.5.9",
    "uuid": "^10.0.0",
    "winston": "^3.15.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.7.5",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^9.12.0",
    "nodemon": "^3.1.7",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
